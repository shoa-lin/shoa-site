---
import { getDictionary, type Locale } from "../lib/i18n";
import { navigationItems } from "../lib/navigation";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const dictionary = getDictionary(locale);
const items = navigationItems(locale);

const isCurrent = (target: string) => target === "/" ? path === "/" : path === target || path.startsWith(`${target}/`);
---

<div class="mobile-nav" data-mobile-nav>
  <button
    class="mobile-nav__trigger icon-button"
    type="button"
    aria-label={dictionary.a11y.menuOpen}
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    data-mobile-nav-open
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </button>
  <nav
    class="mobile-nav__panel"
    id="mobile-nav-panel"
    aria-label={dictionary.a11y.mobileNavigation}
    data-mobile-nav-panel
    hidden
  >
    <div class="mobile-nav__head">
      <span>Shoa Lin</span>
      <button class="icon-button" type="button" aria-label={dictionary.a11y.menuClose} data-mobile-nav-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <div class="mobile-nav__links">
      {
        items.map(({ path: target, href, label }) => (
          <a href={href} aria-current={isCurrent(target) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</div>

